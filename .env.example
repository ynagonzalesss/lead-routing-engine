# Copy to .env and fill in. NEVER commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
PRIORITY_THRESHOLD=7
DEDUP_WINDOW_DAYS=30
MAX_INPUT_CHARS=2000

# Optional: enables cost-per-lead in eval reports. Pull current per-token
# prices from your provider's pricing page — intentionally not hardcoded
# here because they change.
COST_PER_1M_INPUT_USD=
COST_PER_1M_OUTPUT_USD=
